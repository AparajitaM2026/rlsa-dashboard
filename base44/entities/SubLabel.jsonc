{
  "name": "SubLabel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the sub-label"
    },
    "client_account_id": {
      "type": "string",
      "description": "Parent ClientAccount this sub-label belongs to"
    },
    "client_name": {
      "type": "string",
      "description": "Cached parent client name for admin display"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "party_id": {
      "type": "string",
      "description": "Party / tenant id this sub-label belongs to"
    }
  },
  "required": [
    "name",
    "client_account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.client_account_id": "{{user.data.client_account_id}}"
            },
            {
              "data.client_account_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        }
      ]
    }
  }
}