{
  "name": "Payout",
  "type": "object",
  "properties": {
    "client_account_id": {
      "type": "string",
      "description": "ClientAccount this payout belongs to"
    },
    "period": {
      "type": "string",
      "description": "Reporting period in YYYY-MM"
    },
    "gross_revenue": {
      "type": "number",
      "default": 0,
      "description": "Gross revenue for the period"
    },
    "payout_amount": {
      "type": "number",
      "default": 0,
      "description": "Net amount paid after revenue share"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date the payout was issued"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "reference": {
      "type": "string",
      "description": "Optional payment reference / transaction id"
    },
    "party_id": {
      "type": "string",
      "description": "Party / tenant id this payout belongs to"
    }
  },
  "required": [
    "client_account_id",
    "period",
    "payout_amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.client_account_id": "{{user.data.client_account_id}}"
            },
            {
              "data.client_account_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.party_id": "{{user.data.party_id}}"
            },
            {
              "user_condition": {
                "data.access_role": "PARTY_ADMIN"
              }
            }
          ]
        }
      ]
    }
  }
}