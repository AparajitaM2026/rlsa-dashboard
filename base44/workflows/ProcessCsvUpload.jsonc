{
  "name": "Process CSV Upload",
  "description": "Routes an uploaded Orchard CSV revenue file in the background, then caches the period's aggregates. Compressed (.gz/.zip) uploads are extracted once into plain-CSV fragments; each fragment/chunk is routed in a bounded sequence of short, resumable invocations until the whole file is processed. A final resumable aggregation step recomputes the MonthlyAggregate cache (house/client/unmapped totals + per-client/country/store/imprint breakdowns) by summing EVERY row for the period across multiple 200k-row passes (a full month can exceed the per-call entity read-traffic limit), so dashboards read correct totals instantly without rescanning hundreds of thousands of rows. The workflow is a fixed-length chain (not a cycle), so it is not blocked by the platform's unbounded-cycle / infinite-loop prevention.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "CsvUploadJob",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_csv_upload",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "p1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processCsvJob",
            "args": {
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "p2",
          "x-base44": {
            "title": "Process chunk 1"
          }
        }
      },
      {
        "p2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processCsvJob",
            "args": {
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "p3",
          "x-base44": {
            "title": "Process chunk 2"
          }
        }
      },
