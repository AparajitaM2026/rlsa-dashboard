{
  "name": "Run Catalog Search",
  "description": "Background catalog search triggered when an admin creates a CatalogSearchJob. Scans RevenueRow records in resumable 60k-row passes (up to 1.2M rows total) and caches results on the job entity.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "CatalogSearchJob",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_catalog_search",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "s1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runCatalogSearchJob",
            "args": {
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "s2",
          "x-base44": {
            "title": "Search pass 1"
          }
        }
      },
      {
        "s2": {
          "call": "invoke_backend_function",
